# AUGIS Environment Configuration
DJANGO_SECRET_KEY=django-insecure-augis-dev-change-in-production-7823498234
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration (Defaults to SQLite in local dev if DATABASE_URL is not set)
# DATABASE_URL=postgres://augis_user:augis_password@localhost:5432/augis_db

# Security & Sessions
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Static and Media
STATIC_ROOT=static_collected
MEDIA_ROOT=media_private

# AI / ML Settings & Google Gemini API
SIMILARITY_THRESHOLD=0.65
USE_SENTENCE_TRANSFORMERS=True
TRANSFORMER_MODEL_NAME=all-MiniLM-L6-v2
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP & 2FA OTP Settings
AUTH_2FA_ENABLED=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=AICTE AUGIS Portal <augis.aicte.portal@gmail.com>

